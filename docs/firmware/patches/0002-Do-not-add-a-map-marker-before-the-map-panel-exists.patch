 source/graphics/TFT/TFTView_320x240.cpp | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/source/graphics/TFT/TFTView_320x240.cpp b/source/graphics/TFT/TFTView_320x240.cpp
index e681316..cd61817 100644
--- a/source/graphics/TFT/TFTView_320x240.cpp
+++ b/source/graphics/TFT/TFTView_320x240.cpp
@@ -2755,6 +2755,21 @@ void TFTView_320x240::updateLocationMap(uint32_t num)
  */
 void TFTView_320x240::addOrUpdateMap(uint32_t nodeNum, int32_t lat, int32_t lon)
 {
+    // Nothing to put a marker on yet. The map screen is built lazily - map and
+    // objects.raw_map_panel are both null until it has been opened once - while
+    // position packets keep arriving from the mesh regardless. Everything below
+    // parents an LVGL object to raw_map_panel, and LVGL dereferences a parent
+    // without checking it, so lv_image_create panicked with StoreProhibited
+    // roughly once a minute on a busy mesh.
+    //
+    // The "if (map)" checks further down show the case was already known; they
+    // simply run after the object creation that crashes. Markers for nodes heard
+    // before the map is first opened are skipped, and reappear when that node
+    // next broadcasts its position.
+    if (!map || !objects.raw_map_panel) {
+        return;
+    }
+
     auto it = nodeObjects.find(nodeNum);
     if (it == nodeObjects.end()) {
         uint32_t bgColor, fgColor;
